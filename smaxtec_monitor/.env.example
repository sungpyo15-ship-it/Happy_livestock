# ─────────────────────────────────────────────────────────────
# smaXtec 모니터 설정 파일 예시
# 1) 이 파일을 복사해 같은 폴더에 ".env" 로 저장
# 2) 아래 값을 채움.  .env 는 git/메일/메신저로 절대 공유하지 말 것
# ─────────────────────────────────────────────────────────────

# 수집 방식: api (권장, smaXtec 공식 API) / web (화면 자동조작, API 불가 시 대안)
SMX_MODE=api

# [필수] web.smaxtec.com 로그인 정보 (코드·로그에 출력되지 않음)
SMX_USERNAME=
SMX_PASSWORD=

# (권장) smaXtec/리얼팜이 발급한 API 토큰. 있으면 아이디/비번 대신 사용
SMX_API_TOKEN=

# API 주소 / 조회 범위
SMX_API_BASE=https://api.smaxtec.com/integration/v2
SMX_API_LOOKBACK_HOURS=72     # 매 수집 시 최근 N시간 재조회(중복은 자동 제거)
SMX_API_BACKFILL_DAYS=10      # 처음 수집하는 목장은 과거 N일치 한 번에 가져옴 → 7일 추세 즉시 가능
SMX_API_HISTORY_DAYS=410     # 전환기 12개월 성적용 과거이력(목장별 1회만 길게 조회)

# web 모드 로그인 페이지
SMX_LOGIN_URL=https://web.smaxtec.com

# 브라우저 표시 여부 (선택자 확인/디버깅 시 false 로 두면 창이 뜸)
SMX_HEADLESS=true

# 접속 예절: 페이지 이동 사이 대기(초, 무작위)
SMX_MIN_DELAY_SEC=3
SMX_MAX_DELAY_SEC=8
# 실패 시 재시도 횟수 / 페이지 타임아웃(ms)
SMX_MAX_RETRIES=3
SMX_PAGE_TIMEOUT_MS=30000

# 시간대
SMX_TIMEZONE=Asia/Seoul

# 경로 (기본값 사용 권장)
SMX_DB_PATH=data/smaxtec.db
SMX_REPORT_DIR=reports
SMX_LOG_DIR=logs

# (선택) 리포트·모바일 대시보드를 복사할 폴더 → 휴대폰에서 OneDrive/Google Drive 앱으로 열람
# 예: SMX_PUBLISH_DIR=C:\Users\내이름\OneDrive\smaXtec
SMX_PUBLISH_DIR=

# ── (선택) 메일 발송: 일일 리포트·긴급 알림 ──
# Gmail 은 일반 비밀번호가 아니라 "앱 비밀번호" 필요
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
MAIL_FROM=
MAIL_TO=
